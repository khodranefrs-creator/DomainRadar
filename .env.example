# Database.
#
# Local development uses SQLite. The file lives outside the repo (see .gitignore)
# and does not persist on serverless hosts such as Vercel.
DATABASE_URL="file:../data/domain-radar.db"
#
# Vercel production uses PostgreSQL. The value is injected by the connected
# database integration (Vercel -> Project -> Storage) and is never committed here.
# When DATABASE_URL is a postgres:// URL, the Prisma client is generated from
# prisma/postgres/schema.prisma automatically (`npm run db:generate`).

# Access control. "local" (default) only answers loopback hosts
# (localhost, 127.0.0.1, ::1). "deployment" answers any host but requires the
# token below on every request, and refuses all requests if the token is unset.
DOMAIN_RADAR_ACCESS_MODE="local"

# Shared token for deployment mode (HTTP Basic auth password). Generate a long
# random value, e.g. `openssl rand -base64 32`. Never commit a real token.
DOMAIN_RADAR_ACCESS_TOKEN=""

# HTTP Basic auth username for deployment mode. Defaults to "domain-radar".
DOMAIN_RADAR_ACCESS_USER="domain-radar"

# Tests only. Optional PostgreSQL URL for `npm run test:postgres`. The test always
# uses its own `domain_radar_test` schema, so it never touches production data.
# TEST_DATABASE_URL="postgres://user:pass@host:5432/dbname"
