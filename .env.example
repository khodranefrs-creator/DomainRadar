# Database.
#
# Local development uses SQLite. The file lives outside the repo (see .gitignore)
# and does not persist on serverless hosts such as Vercel.
DATABASE_URL="file:../data/domain-radar.db"
#
# Vercel production uses PostgreSQL. The value is injected by the connected
# database integration (Vercel -> Project -> Storage) and is never committed here.
# When DATABASE_URL is a postgres:// URL, the Prisma client is generated from
# prisma/postgres/schema.prisma automatically (`npm run db:generate`).

# Access control. "local" (default) only answers loopback hosts (localhost,
# 127.0.0.1, ::1) and refuses everything else — the safe default for
# development. Any value other than "public" keeps this guard, so a typo can
# never accidentally expose the app.
DOMAIN_RADAR_ACCESS_MODE="local"

# Set to "public" for the hosted deployment. Public mode is intentionally open:
# every page and API is served without authentication. The Host header is not
# used as a boundary. Abuse controls (per-IP rate limits, payload caps and input
# validation) still apply. Requires no token.
# DOMAIN_RADAR_ACCESS_MODE="public"
