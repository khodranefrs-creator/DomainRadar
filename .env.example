# Database. SQLite is for local development only — its file lives outside the
# repo (see .gitignore) and does not persist on serverless hosts such as Vercel.
DATABASE_URL="file:../data/domain-radar.db"

# Access control. "local" (default) only answers loopback hosts
# (localhost, 127.0.0.1, ::1). "deployment" answers any host but requires the
# token below on every request, and refuses all requests if the token is unset.
DOMAIN_RADAR_ACCESS_MODE="local"

# Shared token for deployment mode (HTTP Basic auth password). Generate a long
# random value, e.g. `openssl rand -base64 32`. Never commit a real token.
DOMAIN_RADAR_ACCESS_TOKEN=""

# HTTP Basic auth username for deployment mode. Defaults to "domain-radar".
DOMAIN_RADAR_ACCESS_USER="domain-radar"
