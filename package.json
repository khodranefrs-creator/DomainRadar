{
  "name": "domain-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx scripts/select-prisma-provider.ts && next dev --hostname 127.0.0.1",
    "build": "tsx scripts/select-prisma-provider.ts && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/select-prisma-provider.ts && vitest run",
    "test:watch": "vitest",
    "test:postgres": "prisma generate --schema=prisma/postgres/schema.prisma && vitest run",
    "db:sync-schema": "tsx scripts/sync-prisma-schema.ts",
    "db:generate": "tsx scripts/select-prisma-provider.ts",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/postgres/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "db:deploy:sqlite": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "next": "16.4.2",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "workerd": true,
    "@prisma/engines": true,
    "tsx": true
  }
}
